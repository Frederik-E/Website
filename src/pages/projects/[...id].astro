---
import type { GetStaticPaths } from 'astro';
import Projekt from '../../ansichten/Projekt.astro';
import { projektPfade } from '../../lib/projekte';

export const getStaticPaths = (() => projektPfade('de')) satisfies GetStaticPaths;

const { projekt, projekte } = Astro.props;
---

<Projekt projekt={projekt} projekte={projekte} />
