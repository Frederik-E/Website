---
import BaseLayout from '../layouts/BaseLayout.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import { Content } from '../../inhalt/impressum.md';
import { einstellungen } from '../lib/einstellungen';
import { t } from '../i18n';

const texte = t(einstellungen.sprache);
---

<BaseLayout titel={texte.impressum} beschreibung={texte.impressum} noindex>
  <Seitenkopf titel={texte.impressum} etikett={texte.rechtliches} />

  <div class="feld geteilt">
    <div class="zweispaltig">
      <div class="fliesstext rechts"><Content /></div>
    </div>
  </div>
</BaseLayout>
