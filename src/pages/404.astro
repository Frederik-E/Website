---
/*
  Eine 404-Seite für beide Sprachen: GitHub Pages zeigt bei jeder unbekannten
  Adresse /404.html, auch unter /en/. Deshalb steht unter dem deutschen Text
  derselbe Hinweis auf Englisch, mit Link zur englischen Startseite.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import { t } from '../i18n';

const texte = t('de');
const englisch = t('en');
---

<BaseLayout titel={texte.nichtGefunden} beschreibung={texte.nichtGefundenText} noindex andereFassung="/en/">
  <Seitenkopf titel={texte.nichtGefunden} einleitung={texte.nichtGefundenText} etikett="404">
    <p class="weiter"><a class="dezent" href="/">{texte.zurStartseite}</a></p>
    <p class="englisch" lang="en">
      {englisch.nichtGefunden}. {englisch.nichtGefundenText}
      <a class="dezent" href="/en/">{englisch.zurStartseite}</a>
    </p>
  </Seitenkopf>
</BaseLayout>

<style>
  .weiter {
    margin-top: var(--space-32);
  }

  .englisch {
    margin-top: var(--space-24);
    color: var(--color-text-muted);
  }
</style>
