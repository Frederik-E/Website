---
import BaseLayout from '../layouts/BaseLayout.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import { einstellungen } from '../lib/einstellungen';
import { t } from '../i18n';

const texte = t(einstellungen.sprache);
---

<BaseLayout titel={texte.nichtGefunden} beschreibung={texte.nichtGefundenText} noindex>
  <Seitenkopf titel={texte.nichtGefunden} einleitung={texte.nichtGefundenText} etikett="404">
    <p class="weiter"><a class="dezent" href="/">{texte.zurStartseite}</a></p>
  </Seitenkopf>
</BaseLayout>

<style>
  .weiter {
    margin-top: var(--space-32);
  }
</style>
