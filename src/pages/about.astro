---
import BaseLayout from '../layouts/BaseLayout.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import { Content as UeberMich } from '../../inhalt/ueber-mich.md';
import { einstellungen } from '../lib/einstellungen';
import { t } from '../i18n';

const texte = t(einstellungen.sprache);
const beschreibung =
  einstellungen.sprache === 'de'
    ? `Kurzer Text über ${einstellungen.name}.`
    : `A short text about ${einstellungen.name}.`;
---

<BaseLayout titel={texte.ueberMich} beschreibung={beschreibung}>
  <Seitenkopf titel={texte.ueberMich} />

  <div class="feld geteilt">
    <div class="zweispaltig">
      <div class="fliesstext rechts"><UeberMich /></div>
    </div>
  </div>
</BaseLayout>
