---
import BaseLayout from '../layouts/BaseLayout.astro';
import CvSection from '../components/CvSection.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import { lebenslauf } from '../lib/lebenslauf';
import { einstellungen } from '../lib/einstellungen';
import { cvDateiname } from '../lib/text';
import { t } from '../i18n';

const texte = t(einstellungen.sprache);
const beschreibung =
  einstellungen.sprache === 'de'
    ? `Lebenslauf von ${einstellungen.name}.`
    : `CV of ${einstellungen.name}.`;
---

<BaseLayout titel={texte.lebenslauf} beschreibung={beschreibung}>
  <Seitenkopf titel={texte.lebenslauf}>
    <p class="druck-name">{einstellungen.name}</p>
    <p class="druck-untertitel">{einstellungen.untertitel}</p>
    <p class="herunterladen nicht-drucken">
      <a class="dezent" href="/cv.pdf" download={cvDateiname(einstellungen.name)}>{texte.cvHerunterladen}</a>
    </p>
  </Seitenkopf>

  {
    lebenslauf.abschnitte.map((abschnitt, stelle) => (
      <CvSection abschnitt={abschnitt} nummer={String(stelle + 1).padStart(2, '0')} ebene={2} />
    ))
  }

  <p class="druck-fuss">
    <span>{einstellungen.domain.replace(/^https?:\/\//, '')}</span>
    <span>{einstellungen.email}</span>
  </p>
</BaseLayout>

<style>
  .herunterladen {
    margin-top: var(--space-24);
    font-size: var(--text-ui);
  }

  .druck-name,
  .druck-untertitel,
  .druck-fuss {
    display: none;
  }

  /* Druck: A4 ohne Navigation und Fusszeile, Kontakt unten auf der Seite. */
  @media print {
    @page {
      size: A4;
      margin: 16mm 14mm;
    }

    .herunterladen {
      display: none;
    }

    :global(.seitenkopf h1),
    :global(.seitenkopf .einleitung) {
      display: none;
    }

    .druck-name {
      display: block;
      font-size: 22pt;
      font-weight: 500;
      line-height: 1.1;
      letter-spacing: var(--laufweite-gross);
    }

    .druck-untertitel {
      display: block;
      margin-top: 2mm;
      color: var(--color-text-muted);
    }

    :global(.seitenkopf) {
      padding: 0 0 8mm;
    }

    .druck-fuss {
      display: flex;
      gap: 8mm;
      margin-top: 10mm;
      padding-top: 3mm;
      border-top: 1px solid var(--color-text-muted);
      font-size: 9pt;
      color: var(--color-text-muted);
    }
  }
</style>
