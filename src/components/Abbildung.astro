---
import ProjectMedia from './ProjectMedia.astro';

interface Props {
  projektId: string;
  titelbild: ImageMetadata;
  titelbildAlt?: string;
  video?: string;
  zuerst?: boolean;
  breite?: number;
  sizes?: string;
  bewegt?: boolean;
}

const medium = Astro.props;

/*
  Ein Medium wie auf einer technischen Zeichnung: Sucherecken an den vier
  Ecken.
*/
---

<div class="abbildung">
  <div class="rahmen">
    <div class="bild">
      <ProjectMedia {...medium} />
    </div>
    <span class="sucher" aria-hidden="true"></span>
  </div>
</div>

<style>
  .rahmen {
    position: relative;
  }

  .bild {
    overflow: hidden;
    border-radius: var(--radius);
  }

  .bild :global(.medium) {
    transition: scale 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* Sucherecken: acht kurze Linien aus Verläufen, je zwei pro Ecke. */
  .sucher {
    --l: 12px;
    --strich: var(--color-konstruktion);
    position: absolute;
    inset: -10px;
    pointer-events: none;
    background:
      linear-gradient(var(--strich), var(--strich)) top left / var(--l) 1px no-repeat,
      linear-gradient(var(--strich), var(--strich)) top left / 1px var(--l) no-repeat,
      linear-gradient(var(--strich), var(--strich)) top right / var(--l) 1px no-repeat,
      linear-gradient(var(--strich), var(--strich)) top right / 1px var(--l) no-repeat,
      linear-gradient(var(--strich), var(--strich)) bottom left / var(--l) 1px no-repeat,
      linear-gradient(var(--strich), var(--strich)) bottom left / 1px var(--l) no-repeat,
      linear-gradient(var(--strich), var(--strich)) bottom right / var(--l) 1px no-repeat,
      linear-gradient(var(--strich), var(--strich)) bottom right / 1px var(--l) no-repeat;
    transition:
      inset 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
      --strich 0.5s ease;
  }

  /* Beim Zeigen auf den Eintrag: das Bild rückt leicht näher, die
     Sucherecken ziehen sich zusammen. */
  :global(.zeigbar:hover) .bild :global(.medium) {
    scale: 1.035;
  }

  :global(.zeigbar:hover) .sucher {
    inset: -5px;
    --strich: var(--color-mark);
  }

  @property --strich {
    syntax: '<color>';
    inherits: true;
    initial-value: transparent;
  }
</style>
