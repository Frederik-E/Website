---
import Abbildung from './Abbildung.astro';
import { hatDetailseite, kurzeStichpunkte, type Projekt } from '../lib/projekte';
import { adresse, spracheVon } from '../lib/sprache';
import { monatJahr, t, zeitraum } from '../i18n';

interface Props {
  projekt: Projekt;
  ebene?: 2 | 3;
  zuerst?: boolean;
}

const { projekt, ebene = 3, zuerst = false } = Astro.props;
const sprache = spracheVon(Astro.currentLocale);
const texte = t(sprache);
const daten = projekt.data;

const detailseite = hatDetailseite(projekt);
const titelZiel = detailseite ? adresse(`/projects/${projekt.id}/`, sprache) : (daten.code ?? daten.demo);
const Ueberschrift = `h${ebene}` as 'h2' | 'h3';

const angaben = [
  {
    name: texte.datum,
    wert: daten.bis
      ? zeitraum(daten.datum, daten.bis, sprache)
      : monatJahr(daten.datum, sprache),
  },
  { name: texte.rolle, wert: daten.rolle },
  { name: texte.themen, wert: daten.tags.join(', ') },
].filter((angabe) => angabe.wert);

const kompakt = kurzeStichpunkte(projekt);
---

{/* Datenblatt: links Titel und Angaben, rechts Beschreibung und Bild.
    Der ganze Eintrag ist klickbar, der Titel-Link spannt sich über ihn. */}
<article class="feld geteilt eintrag zeigbar" lang={projekt.kopfSprache !== sprache ? projekt.kopfSprache : undefined}>
  <div class="links erscheinen">
    <Ueberschrift class="titel">
      {titelZiel ? <a class="ziel" href={titelZiel}>{daten.titel}</a> : daten.titel}
      {daten.entwurf && <span class="etikett entwurf">{texte.entwurf}</span>}
    </Ueberschrift>

    <dl class="angaben">
      {
        angaben.map((angabe) => (
          <div>
            <dt class="etikett">{angabe.name}</dt>
            <dd>{angabe.wert}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="rechts erscheinen">
    {daten.kurz && <p class="kurz">{daten.kurz}</p>}
    {
      daten.stichpunkte.length > 0 && (
        <ul class:list={['stichpunkte', { kompakt }]}>
          {daten.stichpunkte.map((punkt) => (
            <li>{punkt}</li>
          ))}
        </ul>
      )
    }
    {
      daten.titelbild && (
        <div class="medium">
          <Abbildung
            projektId={projekt.id}
            titelbild={daten.titelbild}
            titelbildAlt={daten.titelbild_alt}
            video={daten.video}
            zuerst={zuerst}
            breite={1600}
            sizes="(min-width: 80rem) 48rem, (min-width: 60rem) 62vw, 100vw"
            bewegt={false}
          />
        </div>
      )
    }
  </div>
</article>

<style>
  .eintrag {
    display: grid;
    gap: var(--space-32) var(--luecke);
  }

  .ziel {
    color: inherit;
    text-decoration-color: transparent;
  }

  .ziel::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .eintrag:hover .ziel {
    text-decoration-color: currentColor;
  }

  .ziel:focus-visible {
    outline: none;
  }

  .ziel:focus-visible::after {
    outline: 2px solid var(--color-link);
    outline-offset: -4px;
  }

  .titel {
    font-size: var(--text-h2);
  }

  .entwurf {
    display: block;
    margin-top: var(--space-8);
  }

  /* Angaben als Datenblatt: Beschriftung links, Wert rechts, Linie dazwischen. */
  .angaben {
    margin-top: var(--space-32);
    font-size: var(--text-klein);
    line-height: 1.5;
  }

  .angaben > div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--space-12);
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-haarlinie);
  }

  .angaben > div:last-child {
    border-bottom: 1px solid var(--color-haarlinie);
  }

  .angaben dt {
    padding-top: 0.1em;
  }

  .kurz {
    max-width: 44ch;
    font-size: var(--text-gross);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  /* Stichpunkte wie eine Legende auf der Zeichnung: Haarlinien zwischen den
     Zeilen, vor jeder Zeile eine kleine Kreuzmarke wie an den Feldrändern. */
  .stichpunkte {
    max-width: 44ch;
    font-size: var(--text-gross);
    line-height: 1.5;
    border-top: 1px solid var(--color-haarlinie);
  }

  .stichpunkte li {
    display: grid;
    grid-template-columns: var(--space-24) minmax(0, 1fr);
    padding-block: var(--space-12);
    border-bottom: 1px solid var(--color-haarlinie);
  }

  .stichpunkte.kompakt {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: none;
  }

  .stichpunkte.kompakt li {
    padding-right: var(--space-16);
  }

  @media (min-width: 40rem) {
    .stichpunkte.kompakt {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .stichpunkte li::before {
    content: '';
    width: 11px;
    height: 11px;
    margin-top: calc(0.75em - 5.5px);
    background:
      linear-gradient(var(--color-text-muted), var(--color-text-muted)) center / 100% 1px no-repeat,
      linear-gradient(var(--color-text-muted), var(--color-text-muted)) center / 1px 100% no-repeat;
  }

  .kurz + .stichpunkte,
  .medium {
    margin-top: var(--space-32);
  }

  /* Breit: die linke Spalte bleibt beim Scrollen unter der Kopfzeile stehen,
     solange das Bild rechts vorbeiläuft. */
  @media (min-width: 60rem) {
    .eintrag {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    }

    .links {
      position: sticky;
      top: calc(var(--kopf-hoehe) + var(--space-32));
      align-self: start;
    }
  }
</style>
