---
import Zeichen from './Zeichen.astro';
import { einstellungen } from '../lib/einstellungen';
import { STAND } from '../lib/text';
import { t } from '../i18n';

interface Props {
  einleitung?: string;
}

const { einleitung = '' } = Astro.props;
const texte = t(einstellungen.sprache);

/*
  Oben auf der Startseite: die Einleitung groß, daneben das Zeichen als
  Abbildung, die große Punktmatrix. Das Millimeterraster zeichnet das Zeichen
  selbst, damit die Punkte genau auf seinen Kreuzungen liegen. Es reicht über
  das ganze Startbild und liegt unter dem Text. Dahinter ein weicher Schimmer
  aus den beiden Farben des Zeichens.
*/
---

<section class="feld ohne-linie startbild" aria-label={texte.index}>
  {/* Der Inhalt liegt in einer beschnittenen Ebene: das Raster des Zeichens
      reicht weit über die Abbildung hinaus und soll am Rand des Startbilds
      enden. Die Kreuzmarken des Felds liegen außerhalb und bleiben ganz. */}
  <div class="innen">
    <div class="grund" aria-hidden="true">
      <div class="schimmer"></div>
    </div>

    <div class="etiketten">
      <p class="etikett">00 / {texte.index}</p>
      <p class="etikett">{texte.stand} {STAND}</p>
    </div>

    <div class="buehne">
      {einleitung !== '' && <p class="aussage">{einleitung}</p>}

      <figure class="zeichnung" aria-hidden="true">
        <div class="zeichen">
          <Zeichen groesse={320} mitRaster />
        </div>

        <figcaption class="etikett">{texte.abbildung} 01 / {texte.zeichen}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .startbild {
    padding: 0;
  }

  .innen {
    position: relative;
    overflow: clip;
    padding: var(--space-24) var(--innen) clamp(3rem, 2rem + 5vw, 7rem);
  }

  .grund {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .etiketten {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-8) var(--space-24);
  }

  .buehne {
    display: grid;
    gap: var(--space-48);
    align-items: center;
    margin-top: var(--space-48);
  }

  .aussage {
    max-width: 15ch;
    font-size: var(--text-display);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: var(--laufweite-display);
    text-wrap: balance;
    animation: aufsteigen 1s 0.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  /* Unter dem Text, damit das Raster des Zeichens nicht über die Schrift läuft. */
  .zeichnung {
    position: relative;
    z-index: -1;
    order: -1;
    width: min(15rem, 70vw);
    margin: 0;
  }

  .zeichen {
    line-height: 0;
  }

  .zeichen :global(svg) {
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: var(--space-16);
    text-align: center;
  }

  /* Weicher Schimmer aus Cool Sky und Dusty Rose hinter dem Zeichen. */
  .schimmer {
    position: absolute;
    top: 10%;
    left: 0;
    width: 22rem;
    height: 22rem;
    background:
      radial-gradient(circle at 35% 40%, color-mix(in srgb, var(--color-mark) 55%, transparent), transparent 60%),
      radial-gradient(circle at 65% 65%, color-mix(in srgb, var(--color-line) 55%, transparent), transparent 60%);
    filter: blur(48px);
    opacity: 0.55;
    animation: schweben 18s ease-in-out infinite alternate;
    pointer-events: none;
  }

  @keyframes schweben {
    to {
      translate: 2.5rem -1.5rem;
      scale: 1.12;
    }
  }

  @media (min-width: 48rem) {
    .buehne {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--luecke);
      min-height: 24rem;
      margin-top: var(--space-32);
    }

    .zeichnung {
      order: 0;
      width: clamp(15rem, 8rem + 14vw, 22rem);
    }

    .schimmer {
      top: 12%;
      left: auto;
      right: 4%;
      width: 30rem;
      height: 30rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .schimmer {
      animation: none;
    }
  }
</style>
