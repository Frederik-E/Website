---
import Blob from './Blob.astro';
import { spracheVon } from '../lib/sprache';
import { STAND } from '../lib/text';
import { t } from '../i18n';

interface Props {
  einleitung?: string;
}

const { einleitung = '' } = Astro.props;
const texte = t(spracheVon(Astro.currentLocale));

/*
  Oben auf der Startseite: links das Foto (Slot "foto") neben der großen
  Einleitung, darunter das Profil (Slot), rechts als Abbildung der organische
  Blob. Dahinter ein weicher Schimmer aus seinen beiden Farben.
  Fadenkreuz, Messkreis und Millimeterraster aus dem früheren Entwurf hat der
  Betreiber ausdrücklich abgelehnt.
*/
---

<section class="feld ohne-linie startbild" aria-label={texte.index}>
  {/* Der Inhalt liegt in einer beschnittenen Ebene, damit der Schimmer am
      Rand des Startbilds endet. Die Kreuzmarken des Felds liegen außerhalb
      und bleiben ganz. */}
  <div class="innen">
    <div class="grund" aria-hidden="true">
      <div class="schimmer"></div>
    </div>

    {/* "00 / Index" und "Abb. 01 / Zeichen" hat der Betreiber entfernen lassen. */}
    <p class="etikett stand">{texte.stand} {STAND}</p>

    <div class="buehne">
      <div class="text">
        <div class="kopf">
          <slot name="foto" />
          {einleitung !== '' && <p class="aussage">{einleitung}</p>}
        </div>
        {
          Astro.slots.has('default') && (
            <div class="profil">
              <slot />
            </div>
          )
        }
      </div>

      <div class="zeichnung" aria-hidden="true">
        <div class="flaeche">
          <div class="blob">
            <Blob />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .startbild {
    padding: 0;
  }

  .innen {
    position: relative;
    overflow: clip;
    padding: var(--space-24) var(--innen) clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  .grund {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .stand {
    text-align: right;
  }

  .buehne {
    display: grid;
    gap: var(--space-32);
    align-items: center;
    margin-top: var(--space-32);
  }

  /* Foto und große Zeile als Block: das Foto links, senkrecht mittig zur
     Zeile. */
  .kopf {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 0.5rem + 2vw, 2rem);
  }

  .kopf > :global(.portrait) {
    animation: aufsteigen 1s 0.05s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  /* Das Profil unter der großen Zeile, gut lesbar. */
  .profil {
    max-width: 56ch;
    margin-top: var(--space-32);
    font-size: var(--text-gross);
    line-height: 1.55;
    animation: aufsteigen 1s 0.25s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .profil > :global(* + *) {
    margin-top: var(--space-16);
  }

  .aussage {
    min-width: 0;
    max-width: 15ch;
    font-size: var(--text-display);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: var(--laufweite-display);
    text-wrap: balance;
    animation: aufsteigen 1s 0.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  /* Die Zeichnung: der Blob sitzt mittig in einer quadratischen Fläche. Der
     schmale Rand reicht, damit die Formen beim Auseinandergehen nicht über
     die Fläche hinausragen. */
  .zeichnung {
    order: -1;
    width: min(11rem, 60vw);
    margin: 0;
  }

  .flaeche {
    position: relative;
    aspect-ratio: 1;
  }

  .blob {
    position: absolute;
    inset: 6%;
    line-height: 0;
  }

  .blob :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* Weicher Schimmer aus Cool Sky und Dusty Rose hinter dem Blob. */
  .schimmer {
    position: absolute;
    top: 10%;
    left: 0;
    width: 22rem;
    height: 22rem;
    background:
      radial-gradient(circle at 35% 40%, color-mix(in srgb, var(--color-mark) 55%, transparent), transparent 60%),
      radial-gradient(circle at 65% 65%, color-mix(in srgb, var(--color-line) 55%, transparent), transparent 60%);
    filter: blur(48px);
    opacity: 0.55;
    animation: schweben 18s ease-in-out infinite alternate;
    pointer-events: none;
  }

  @media (min-width: 48rem) {
    .buehne {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--luecke);
      margin-top: var(--space-24);
    }

    .zeichnung {
      order: 0;
      width: clamp(12rem, 6rem + 10vw, 16rem);
    }

    .schimmer {
      top: 12%;
      left: auto;
      right: 4%;
      width: 30rem;
      height: 30rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .schimmer {
      animation: none;
    }
  }
</style>
