---
import { BLOB, ZEICHEN_BREITE, ZEICHEN_HOEHE, ZEICHEN_DAUER } from '../lib/zeichen';
import '../styles/zeichen.css';

interface Props {
  /** Kantenlänge in Pixeln. In der Kopfzeile klein, im Startbild groß. */
  groesse?: number;
}

const { groesse = 46 } = Astro.props;

/*
  Zwei Formen übereinander, leicht versetzt und gegeneinander gedreht.
  Beide benutzen dieselben Keyframes, die zweite mit negativer Verzögerung.
  Dadurch stehen sie immer an verschiedenen Stellen ihrer Bewegung und
  schieben sich dynamisch übereinander, ohne dass zweite Formdaten nötig sind.

  Zweimal pro Takt gehen die Formen auseinander, bis sie sich nicht mehr
  berühren, und kommen mit getauschter Reihenfolge zurück. SVG kennt kein
  z-index, deshalb liegt eine zweite blaue Form ganz oben und wird im Moment
  der Trennung sichtbar oder unsichtbar geschaltet.
*/
const ZWEITE = {
  versatz: `translate(5 4) rotate(140 ${ZEICHEN_BREITE / 2} ${ZEICHEN_HOEHE / 2}) scale(0.94)`,
  verzoegerung: '-13s',
};

// Die Trennung fällt auf die Hälfte der Blob-Schleife. Dort stehen die Formen
// schräg versetzt und kommen mit dem Weg in "auseinander-*" frei.
const TAKT = `${parseFloat(ZEICHEN_DAUER) * 2}s`;
---

<svg
  class="zeichen-bild"
  viewBox={`0 0 ${ZEICHEN_BREITE} ${ZEICHEN_HOEHE}`}
  width={groesse}
  height={groesse}
  aria-hidden="true"
  focusable="false"
  style={`--dauer: ${ZEICHEN_DAUER}; --verzoegerung: ${ZWEITE.verzoegerung}; --takt: ${TAKT};`}
>
  <g class="blau">
    <path class="form" d={BLOB} />
  </g>
  <g class="rose">
    <g transform={ZWEITE.versatz}>
      <path class="form" d={BLOB} />
    </g>
  </g>
  <g class="blau vorn">
    <path class="form" d={BLOB} />
  </g>
</svg>

<style>
  .zeichen-bild {
    display: block;
    overflow: visible;
  }

  .form {
    animation: blob var(--dauer) linear infinite;
  }

  .blau {
    fill: var(--color-mark);
    animation: auseinander-blau var(--takt) ease-in-out infinite;
  }

  .rose {
    fill: var(--color-line);
    animation: auseinander-rose var(--takt) ease-in-out infinite;
  }

  .rose .form {
    animation-delay: var(--verzoegerung);
  }

  .vorn {
    opacity: 0;
    animation:
      auseinander-blau var(--takt) ease-in-out infinite,
      vorn var(--takt) step-end infinite;
  }

  @keyframes auseinander-blau {
    0%, 15%, 35%, 65%, 85%, 100% {
      transform: translate(0, 0);
    }
    25%, 75% {
      transform: translate(-8.8px, -8.8px);
    }
  }

  @keyframes auseinander-rose {
    0%, 15%, 35%, 65%, 85%, 100% {
      transform: translate(0, 0);
    }
    25%, 75% {
      transform: translate(8.8px, 8.8px);
    }
  }

  /* Umschalten nur bei 25 % und 75 %, dem weitesten Abstand. */
  @keyframes vorn {
    0% {
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    75% {
      opacity: 0;
    }
  }

  /* Ohne CSS-Unterstützung für "d" bleibt die Ausgangsform aus dem Attribut
     stehen. Das Zeichen ist dann still, aber vollständig, Rose vorn. */
  @media (prefers-reduced-motion: reduce) {
    .zeichen-bild * {
      animation: none;
    }
  }

  @media print {
    .zeichen-bild * {
      animation: none;
    }
  }
</style>
