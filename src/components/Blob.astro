---
import { BLOB_BREITE, BLOB_HOEHE, BLOB_DAUER } from '../lib/blob';

interface Props {
  /** Kantenlänge in Pixeln. In der Kopfzeile klein, im Startbild überschreibt das CSS sie. */
  groesse?: number;
  /**
   * "beide": blaue und rosa Form wie auf der Startseite. "blau" oder "rose":
   * nur diese eine Form, so wie sie dort aussieht (Lebenslauf blau, Projekte
   * rosa, Wunsch des Betreibers vom 2026-11-02).
   */
  farbe?: 'beide' | 'blau' | 'rose';
}

const { groesse = 280, farbe = 'beide' } = Astro.props;

/*
  Der organische Blob aus Commit 559fdb9, als Zeichen in der Kopfzeile und
  als Blickfang im Startbild.

  Zwei Formen übereinander, leicht versetzt und gegeneinander gedreht. Die
  Formdaten und ihre Animation stehen einmal pro Seite in BlobFormen.astro
  (im BaseLayout), hier stehen nur Verweise darauf (<use>). Die rosa Form ist
  der blauen in derselben Bewegung voraus, so schieben sie sich
  übereinander.

  Zweimal pro Takt gehen die Formen auseinander, bis sie sich nicht mehr
  berühren, und kommen mit getauschter Reihenfolge zurück. SVG kennt kein
  z-index, deshalb liegt eine zweite blaue Form ganz oben und wird im Moment
  der Trennung sichtbar oder unsichtbar geschaltet.

  Jede Form wirft einen leichten Schatten in Iron Grey, so liegt die vordere
  sichtbar auf der hinteren (Wunsch des Betreibers vom 2026-10-30). Der
  Schatten steht als SVG-Filter am äußeren Element, damit er bei der
  gedrehten rosa Form trotzdem nach unten fällt. CSS-Filter an SVG-Elementen
  kann Safari nicht zuverlässig.

  Eine einzelne Form ("blau" oder "rose") behält ihre Formänderung, Lage und
  Verzögerung. Auseinandergehen und Reihenfolgetausch entfallen, sie ergeben
  nur mit beiden Formen Sinn.
*/
// Kopfzeile und Seite zeigen den Blob gleichzeitig. Jede Fassung bekommt
// deshalb ihren eigenen Filter, sonst gäbe es die ID doppelt.
const SCHATTEN = `blob-schatten-${farbe}-${groesse}`;
const VERSATZ_ROSE = `translate(5 4) rotate(140 ${BLOB_BREITE / 2} ${BLOB_HOEHE / 2}) scale(0.94)`;

// Die Trennung fällt auf die Hälfte der Formschleife. Dort stehen die Formen
// schräg versetzt und kommen mit dem Weg in "blob-auseinander-*" frei.
const TAKT = `${parseFloat(BLOB_DAUER) * 2}s`;
---

<svg
  class="blob-bild"
  viewBox={`0 0 ${BLOB_BREITE} ${BLOB_HOEHE}`}
  width={groesse}
  height={groesse}
  aria-hidden="true"
  focusable="false"
  style={`--takt: ${TAKT};`}
>
  <defs>
    <filter id={SCHATTEN} x="-25%" y="-25%" width="150%" height="150%" color-interpolation-filters="sRGB">
      <feDropShadow class="schatten" dx="0" dy="1" stdDeviation="1.4" />
    </filter>
  </defs>
  {
    farbe !== 'rose' && (
      <g class:list={['blau', farbe !== 'beide' && 'allein']} filter={`url(#${SCHATTEN})`}>
        <use class="bewegt" href="#blob-form-blau" />
        <use class="still" href="#blob-form-still" />
      </g>
    )
  }
  {
    farbe !== 'blau' && (
      <g class:list={['rose', farbe !== 'beide' && 'allein']} filter={`url(#${SCHATTEN})`}>
        <g transform={VERSATZ_ROSE}>
          <use class="bewegt" href="#blob-form-rose" />
          <use class="still" href="#blob-form-still" />
        </g>
      </g>
    )
  }
  {
    farbe === 'beide' && (
      <g class="blau vorn" filter={`url(#${SCHATTEN})`}>
        <use class="bewegt" href="#blob-form-blau" />
        <use class="still" href="#blob-form-still" />
      </g>
    )
  }
</svg>

<style>
  .blob-bild {
    display: block;
    overflow: visible;
  }

  .still {
    display: none;
  }

  .schatten {
    flood-color: var(--color-text);
    flood-opacity: 0.22;
  }

  .blau {
    fill: var(--color-mark);
    animation: blob-auseinander-blau var(--takt) ease-in-out infinite;
  }

  .rose {
    fill: var(--color-line);
    animation: blob-auseinander-rose var(--takt) ease-in-out infinite;
  }

  /* Allein gibt es niemanden, von dem die Form weggehen könnte. */
  .allein {
    animation: none;
  }

  .vorn {
    opacity: 0;
    animation:
      blob-auseinander-blau var(--takt) ease-in-out infinite,
      blob-vorn var(--takt) step-end infinite;
  }

  @keyframes blob-auseinander-blau {
    0%, 15%, 35%, 65%, 85%, 100% {
      transform: translate(0, 0);
    }
    25%, 75% {
      transform: translate(-8.8px, -8.8px);
    }
  }

  @keyframes blob-auseinander-rose {
    0%, 15%, 35%, 65%, 85%, 100% {
      transform: translate(0, 0);
    }
    25%, 75% {
      transform: translate(8.8px, 8.8px);
    }
  }

  /* Umschalten nur bei 25 % und 75 %, dem weitesten Abstand. */
  @keyframes blob-vorn {
    0% {
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    75% {
      opacity: 0;
    }
  }

  /* Ohne Bewegung steht die Ausgangsform, Rose vorn. Die SVG-Animation der
     Form lässt sich per CSS nicht anhalten, deshalb wird stattdessen die
     stehende Form gezeigt. */
  @media (prefers-reduced-motion: reduce), print {
    .blob-bild * {
      animation: none;
    }

    .bewegt {
      display: none;
    }

    .still {
      display: inline;
    }
  }
</style>
