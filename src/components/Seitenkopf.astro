---
import { einstellungen } from '../lib/einstellungen';
import { eintragFuer } from '../lib/navigation';
import { STAND } from '../lib/text';
import { t } from '../i18n';

interface Props {
  titel: string;
  einleitung?: string;
  /** Beschriftung oben links. Ohne Angabe: Nummer und Name aus der Navigation. */
  etikett?: string;
  /** Beschriftung oben rechts. Ohne Angabe: Stand der Seite. */
  etikettRechts?: string;
}

const texte = t(einstellungen.sprache);
const { titel, einleitung, etikett, etikettRechts } = Astro.props;
const eintrag = await eintragFuer(Astro.url.pathname, texte);
const links = etikett ?? (eintrag ? `${eintrag.nummer} / ${eintrag.text}` : titel);
const rechts = etikettRechts ?? `${texte.stand} ${STAND}`;
---

<header class="feld ohne-linie seitenkopf">
  <div class="raster-grund" aria-hidden="true"></div>

  <div class="etiketten">
    <p class="etikett">{links}</p>
    <p class="etikett">{rechts}</p>
  </div>

  <h1>{titel}</h1>
  {einleitung && <p class="einleitung">{einleitung}</p>}
  <slot />
</header>

<style>
  .seitenkopf {
    padding-block: var(--space-24) clamp(3rem, 2rem + 4vw, 6rem);
  }

  .etiketten {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-8) var(--space-24);
    margin-bottom: clamp(3rem, 2rem + 5vw, 7rem);
  }

  h1 {
    max-width: 16ch;
    animation: aufsteigen 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .einleitung {
    margin-top: var(--space-24);
    max-width: 40ch;
    font-size: var(--text-gross);
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--color-text-muted);
    animation: aufsteigen 0.9s 0.12s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @media print {
    .etiketten {
      display: none;
    }
  }
</style>
