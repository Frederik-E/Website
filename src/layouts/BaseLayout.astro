---
import { Font } from 'astro:assets';
import Blob from '../components/Blob.astro';
import BlobFormen from '../components/BlobFormen.astro';
import { einstellungenIn } from '../lib/einstellungen';
import { navigation } from '../lib/navigation';
import { adresse, andereSprache, ohneSprache, spracheVon } from '../lib/sprache';
import { STAND } from '../lib/text';
import { t } from '../i18n';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  /** Name der Seite. Auf der Startseite leer lassen. */
  titel?: string;
  beschreibung: string;
  istStartseite?: boolean;
  /** Absolute Adresse eines Vorschaubildes für geteilte Links. */
  ogBild?: string;
  noindex?: boolean;
  /**
   * Ziel des Sprachwechsels in der Kopfzeile. Ohne Angabe dieselbe Seite in
   * der anderen Sprache; die 404-Seite verweist auf die andere Startseite.
   */
  andereFassung?: string;
}

const {
  titel,
  beschreibung,
  istStartseite = false,
  ogBild,
  noindex = false,
} = Astro.props;
const sprache = spracheVon(Astro.currentLocale);
const zweite = andereSprache(sprache);
const texte = t(sprache);
const einstellungen = einstellungenIn(sprache);

const seitentitel = istStartseite
  ? `${einstellungen.name}, ${einstellungen.untertitel}`
  : `${titel} | ${einstellungen.name}`;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Dieselbe Seite in der anderen Sprache. Jede Seite gibt es in beiden.
const andereFassung = Astro.props.andereFassung ?? adresse(ohneSprache(Astro.url.pathname), zweite);
const fassungen = {
  de: new URL(adresse(ohneSprache(Astro.url.pathname), 'de'), Astro.site).href,
  en: new URL(adresse(ohneSprache(Astro.url.pathname), 'en'), Astro.site).href,
};
const ogLocale = { de: 'de_DE', en: 'en_GB' } as const;

const sameAs = [einstellungen.github, einstellungen.linkedin].filter(
  (adresse) => adresse !== '' && !adresse.includes('[TODO'),
);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: einstellungen.name,
  url: Astro.site?.href ?? canonical,
  jobTitle: einstellungen.untertitel,
  ...(sameAs.length > 0 ? { sameAs } : {}),
};

// Feste Seiten plus alles aus inhalt/seiten/ mit navigation: true.
// Die Kopfzeile markiert den aktuellen Punkt selbst. Auf einer Projekt-
// Detailseite bleibt dadurch "Projekte" markiert.
const eintraege = await navigation(texte, sprache);
const seitenname = istStartseite ? texte.index : titel;

const pfad = Astro.url.pathname;
const zustand = (adresse: string) => {
  if (pfad === adresse) return 'page' as const;
  return pfad.startsWith(adresse) ? ('true' as const) : undefined;
};
---

<!doctype html>
<html lang={sprache}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{seitentitel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="de" href={fassungen.de} />
          <link rel="alternate" hreflang="en" href={fassungen.en} />
          <link rel="alternate" hreflang="x-default" href={fassungen.de} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:title" content={seitentitel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[sprache]} />
    <meta property="og:locale:alternate" content={ogLocale[zweite]} />
    {ogBild && <meta property="og:image" content={ogBild} />}
    <meta name="twitter:card" content={ogBild ? 'summary_large_image' : 'summary'} />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-etikett" preload />
    <Font cssVariable="--font-mono" />

    {
      istStartseite && (
        <script type="application/ld+json" set:html={JSON.stringify(person)} is:inline />
      )
    }
  </head>
  <body>
    <BlobFormen />
    <a class="sprunglink" href="#inhalt">{texte.zumInhalt}</a>

    <header class="kopfzeile">
      <div class="blatt kopf">
        <a class="zeichen" href={adresse('/', sprache)} aria-label={texte.zurStartseite}>
          <Blob groesse={36} />
        </a>

        <div class="rechts">
          <nav class="nav" aria-label={texte.navigation}>
            {
              eintraege.map((eintrag) => (
                <a href={eintrag.adresse} aria-current={zustand(eintrag.adresse)}>
                  <span class:list={['text', zustand(eintrag.adresse) && 'mark']}>{eintrag.text}</span>
                </a>
              ))
            }
          </nav>
          {/* Dieselbe Seite in der anderen Sprache, in deren eigener Sprache benannt. */}
          <a class="sprachwechsel" href={andereFassung} hreflang={zweite} lang={zweite}>
            <span class="text">{texte.sprachwechsel}</span>
          </a>
        </div>
      </div>
    </header>

    <main id="inhalt" class="blatt">
      <slot />
    </main>

    <footer class="fusszeile">
      <div class="blatt">
        <section class="feld ohne-linie kontakt" aria-labelledby="kontakt-titel">
          <h2 class="etikett" id="kontakt-titel">{texte.kontakt}</h2>
          <a class="mail" href={`mailto:${einstellungen.email}`}>{einstellungen.email}</a>
          <nav class="reihe" aria-label={texte.kontakt}>
            {einstellungen.github !== '' && <a href={einstellungen.github} rel="me noopener">{texte.navGithub}</a>}
            {einstellungen.linkedin !== '' && <a href={einstellungen.linkedin} rel="me noopener">{texte.navLinkedin}</a>}
            <a href={`mailto:${einstellungen.email}`}>{texte.mailSchreiben}</a>
          </nav>
        </section>

        {/* Schriftfeld wie auf einer technischen Zeichnung: nur echte Angaben
            über diese Seite, nichts Erfundenes. */}
        <div class="feld schriftfeld">
          <dl class="zellen">
            <div>
              <dt class="etikett">{texte.name}</dt>
              <dd>{einstellungen.name}</dd>
            </div>
            <div>
              <dt class="etikett">{texte.seite}</dt>
              <dd>{seitenname}</dd>
            </div>
            <div>
              <dt class="etikett">{texte.pfad}</dt>
              <dd class="mono">{Astro.url.pathname}</dd>
            </div>
            <div>
              <dt class="etikett">{texte.stand}</dt>
              <dd class="mono stand">{STAND}</dd>
            </div>
            <div>
              <dt class="etikett">{texte.rechtliches}</dt>
              <dd class="reihe">
                <a href={adresse('/impressum/', sprache)}>{texte.impressum}</a>
                <a href={adresse('/datenschutz/', sprache)}>{texte.datenschutz}</a>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Kopfzeile: bleibt oben stehen, halb durchscheinend mit Unschärfe. Die
     Randlinien des Blatts laufen durch sie hindurch. */
  .kopfzeile {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    backdrop-filter: blur(16px) saturate(1.6);
    border-bottom: 1px solid var(--color-haarlinie);
  }

  .kopf {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
    height: var(--kopf-hoehe);
    padding-inline: var(--innen);
  }

  .zeichen {
    display: block;
    line-height: 0;
    text-decoration: none;
  }

  /* Rechts: Navigation, dahinter durch eine Haarlinie getrennt der Wechsel
     in die andere Sprache. */
  .rechts {
    display: flex;
    align-items: center;
    gap: var(--space-24);
    font-size: var(--text-ui);
    line-height: 1.4;
  }

  .nav {
    display: flex;
    gap: var(--space-8) var(--space-24);
  }

  .sprachwechsel {
    padding-left: var(--space-24);
    border-left: 1px solid var(--color-haarlinie);
  }

  /* Sehr schmale Bildschirme (bis 320 px): engere Abstände, damit die
     Kopfzeile mit dem Sprachwechsel nicht seitlich überläuft. */
  @media (max-width: 24rem) {
    .rechts,
    .nav {
      column-gap: var(--space-16);
    }

    .sprachwechsel {
      padding-left: var(--space-16);
    }
  }

  .nav a,
  .sprachwechsel {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .nav a:hover,
  .nav a[aria-current],
  .sprachwechsel:hover {
    color: var(--color-text);
  }

  /* Beim Zeigen wächst eine feine Linie unter dem Wort von links heran. */
  .nav a:not([aria-current]) .text,
  .sprachwechsel .text {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .nav a:not([aria-current]):hover .text,
  .sprachwechsel:hover .text {
    background-size: 100% 1px;
  }

  main {
    flex: 1 0 auto;
  }

  /* Dunkle Fläche: Kontakt und Schriftfeld. Zwei weiche Farbschimmer aus der
     Palette liegen am unteren Rand. */
  .fusszeile {
    --linie: var(--color-linie-dunkel);
    color: var(--color-auf-dunkel);
    background:
      radial-gradient(55% 90% at 88% 115%, color-mix(in srgb, var(--color-mark) 24%, transparent), transparent 70%),
      radial-gradient(40% 70% at 8% 125%, color-mix(in srgb, var(--color-line) 30%, transparent), transparent 70%),
      var(--color-dunkel);
  }

  .fusszeile .feld {
    --kreuz: var(--color-auf-dunkel-leise);
  }

  .fusszeile .etikett {
    color: var(--color-auf-dunkel-leise);
  }

  .fusszeile a {
    color: inherit;
    text-decoration-color: var(--color-linie-dunkel);
  }

  .fusszeile a:hover {
    text-decoration-color: currentColor;
  }

  .kontakt {
    padding-block: clamp(4rem, 2.5rem + 6vw, 8rem) clamp(3rem, 2rem + 4vw, 6rem);
  }

  .mail {
    display: inline-block;
    margin-top: var(--space-24);
    font-size: clamp(1.375rem, 1rem + 1.6vw, 2.25rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: var(--laufweite-gross);
    overflow-wrap: anywhere;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .fusszeile .mail:hover {
    text-decoration-color: var(--color-mark);
  }

  .reihe {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-24);
  }

  .kontakt .reihe {
    margin-top: var(--space-32);
    font-size: var(--text-ui);
  }

  /* Schriftfeld: fünf Zellen, schmal zwei pro Zeile. */
  .schriftfeld {
    padding: 0;
  }

  .schriftfeld dl {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .schriftfeld dl > div:last-child {
    grid-column: 1 / -1;
  }

  .mono {
    font-family: var(--font-etikett, system-ui, sans-serif);
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .stand {
    white-space: nowrap;
  }

  @media (min-width: 60rem) {
    .schriftfeld dl {
      grid-template-columns: var(--erste-spalte) 0.9fr 1.3fr minmax(max-content, 0.7fr) 1.2fr;
    }

    .schriftfeld dl > div:last-child {
      grid-column: auto;
    }
  }

  @media print {
    .kopfzeile,
    .fusszeile {
      display: none;
    }
  }
</style>
