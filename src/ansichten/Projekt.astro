---
/*
  Detailseite eines Projekts, für /projects/<ordner>/ und /en/projects/<ordner>/.
  Die Pfade legen die Seiten unter src/pages/ mit projektPfade() fest.
*/
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import Abbildung from '../components/Abbildung.astro';
import LinkedinBeitrag from '../components/LinkedinBeitrag.astro';
import { naechstesProjekt, type Projekt } from '../lib/projekte';
import { ogAdresse } from '../lib/og';
import { adresse, spracheVon } from '../lib/sprache';
import { monatJahr, t, zeitraum } from '../i18n';

interface Props {
  projekt: Projekt;
  projekte: Projekt[];
}

const { projekt, projekte } = Astro.props;
const daten = projekt.data;
const sprache = spracheVon(Astro.currentLocale);
const texte = t(sprache);
const { Content } = await render(projekt.text);
const naechstes = naechstesProjekt(projekte, projekt);
const ogBild = await ogAdresse(daten.titelbild, Astro.site);
const hatVerweise = Boolean(daten.code || daten.demo);
// Ein Projekt ohne "bis" nennt nur seinen Monat, eines mit "bis" den Zeitraum.
const zeitangabe = daten.bis ? zeitraum(daten.datum, daten.bis, sprache) : monatJahr(daten.datum, sprache);
// Fehlt die Übersetzung, steht der deutsche Text da und ist so ausgezeichnet.
const kopfLang = projekt.kopfSprache !== sprache ? projekt.kopfSprache : undefined;
const textLang = projekt.textSprache !== sprache ? projekt.textSprache : undefined;
---

<BaseLayout titel={daten.titel} beschreibung={daten.kurz ?? daten.stichpunkte.join(', ')} ogBild={ogBild}>
  <Seitenkopf
    lang={kopfLang}
    titel={daten.titel}
    einleitung={daten.kurz}
    etikett={texte.projekte}
    etikettRechts={daten.bis ? `${daten.datum} \u2013 ${daten.bis}` : daten.datum}
  />

  {/* Angaben als Schriftfeld: Zellen mit Linien dazwischen. */}
  <div class="feld angaben">
    <dl class="zellen">
      <div>
        <dt class="etikett">{texte.datum}</dt>
        <dd>{zeitangabe}</dd>
      </div>
      {
        daten.rolle && (
          <div>
            <dt class="etikett">{texte.rolle}</dt>
            <dd>{daten.rolle}</dd>
          </div>
        )
      }
      {
        daten.tags.length > 0 && (
          <div>
            <dt class="etikett">{texte.themen}</dt>
            <dd>{daten.tags.join(', ')}</dd>
          </div>
        )
      }
      {
        hatVerweise && (
          <div>
            <dt class="etikett">{texte.verweise}</dt>
            <dd class="verweise dezent">
              {daten.code && <a href={daten.code}>{texte.codeAufGithub}</a>}
              {daten.demo && <a href={daten.demo}>{texte.demoAnsehen}</a>}
            </dd>
          </div>
        )
      }
    </dl>
  </div>

  {
    daten.titelbild && (
      <div class="feld medium erscheinen">
        <Abbildung
          projektId={projekt.id}
          titelbild={daten.titelbild}
          titelbildAlt={daten.titelbild_alt}
          video={daten.video}
          breite={1600}
          zuerst
        />
      </div>
    )
  }

  <div class="feld geteilt">
    <div class="fliesstext gegliedert" lang={textLang}>
      <Content />
      {/* Ein LinkedIn-Beitrag steht als letzter Abschnitt im Text, die
          Überschrift links wie bei den Abschnitten darüber. */}
      {
        daten.linkedin && (
          <h2 lang={textLang && sprache}>{texte.linkedinUeberschrift}</h2>
        )
      }
      {
        daten.linkedin && (
          <LinkedinBeitrag
            url={daten.linkedin}
            text={daten.linkedin_text}
            textLang={kopfLang}
          />
        )
      }
    </div>
  </div>

  <nav class="feld weiter" aria-label={texte.projekte}>
    {
      naechstes && (
        <a class="weiter-link" href={adresse(`/projects/${naechstes.id}/`, sprache)}>
          <span class="etikett">{texte.naechstesProjekt}</span>
          <span class="weiter-titel">{naechstes.data.titel}</span>
        </a>
      )
    }
    <a class="weiter-link alle" href={adresse('/projects/', sprache)}>
      <span class="etikett">{texte.projekte}</span>
      <span class="weiter-titel">{texte.zurueckZuProjekten}</span>
    </a>
  </nav>
</BaseLayout>

<style>
  .angaben {
    padding: 0;
  }

  .angaben dl {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .verweise {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .medium {
    padding-block: var(--feld);
  }

  .weiter {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-32) var(--space-48);
  }

  .weiter-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    color: inherit;
    text-decoration: none;
  }

  .weiter-titel {
    font-size: var(--text-h2);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: var(--laufweite-titel);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.2s ease;
  }

  .weiter-link:hover .weiter-titel {
    text-decoration-color: currentColor;
  }

  .alle {
    margin-left: auto;
    text-align: right;
  }

  /* Die erste Zelle ist so breit wie die linke Spalte des Rasters, damit
     die Linie darunter mit der des Fließtexts fluchtet. */
  @media (min-width: 60rem) {
    .angaben dl {
      grid-template-columns: var(--erste-spalte) repeat(3, minmax(0, 1fr));
    }
  }
</style>
