---
/*
  Die Startseite, für / und /en/. Die Sprache folgt aus der Adresse.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import Startbild from '../components/Startbild.astro';
import CvSection from '../components/CvSection.astro';
import Portrait from '../components/Portrait.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import { alleProjekte, startseitenProjekte } from '../lib/projekte';
import { alleSeiten } from '../lib/seiten';
import { lebenslaufIn } from '../lib/lebenslauf';
import { einstellungenIn } from '../lib/einstellungen';
import { ogAdresse } from '../lib/og';
import { adresse, spracheVon } from '../lib/sprache';
import { cvDateiname } from '../lib/text';
import { monatJahr, t } from '../i18n';

const sprache = spracheVon(Astro.currentLocale);
const texte = t(sprache);
const einstellungen = einstellungenIn(sprache);
const { kurzfassung } = lebenslaufIn(sprache);
const projekte = await alleProjekte(sprache);
const auswahl = startseitenProjekte(projekte);
const ogBild = await ogAdresse(auswahl[0]?.data.titelbild, Astro.site);

// Datenleiste über den Arbeiten: nur Angaben, die aus den Projekten folgen.
const themen = [...new Set(projekte.flatMap((projekt) => projekt.data.tags))];
const daten = [
  { name: texte.projekte, wert: String(projekte.length) },
  ...(projekte[0] ? [{ name: texte.zuletzt, wert: monatJahr(projekte[0].data.datum, sprache) }] : []),
  ...(themen.length > 0 ? [{ name: texte.themen, wert: themen.join(', ') }] : []),
];

// Reihenfolge: oben Foto und große Zeile, dann der Lebenslauf in Kurzform,
// danach die Arbeiten. Freie Seiten aus
// inhalt/seiten/ stehen am Ende, wenn es welche gibt.
const weitereInhalte = (await alleSeiten(sprache)).map((seite) => ({
  adresse: adresse(`/${seite.id}/`, sprache),
  titel: seite.data.titel,
  beschreibung: seite.data.beschreibung ?? '',
}));
---

<BaseLayout istStartseite beschreibung={einstellungen.einleitung || einstellungen.untertitel} ogBild={ogBild}>
  <h1 class="nur-vorlesen">{einstellungen.name}</h1>

  {/* Das Foto steht links neben der großen Zeile. Den Profiltext darunter
      hat der Betreiber am 2026-11-02 entfernen lassen: als Text ganz oben
      wirkt er wie ein Lebenslauf. Er steht nur noch auf /cv/. */}
  <Startbild einleitung={einstellungen.einleitung}>
    <Portrait slot="foto" breite="clamp(4.5rem, 1rem + 8vw, 8rem)" sizes="8rem" zuerst />
  </Startbild>

  {
    kurzfassung.length > 0 && (
      <section aria-labelledby="lebenslauf">
        <div class="feld knapp geteilt abschnittskopf">
          <h2 class="etikett" id="lebenslauf">{texte.lebenslauf}</h2>
          <p class="verweise">
            <a class="etikett alle" href={adresse('/cv/', sprache)}>{texte.lebenslaufGanz}</a>
            <a class="etikett alle" href={adresse('/cv.pdf', sprache)} download={cvDateiname(einstellungen.name, sprache)}>
              {texte.lebenslaufPdf}
            </a>
          </p>
        </div>

        {kurzfassung.map((abschnitt) => (
          <CvSection abschnitt={abschnitt} ebene={3} kurz />
        ))}
      </section>
    )
  }

  <section aria-labelledby="arbeiten">
    <div class="feld knapp geteilt abschnittskopf">
      <h2 class="etikett" id="arbeiten">{texte.ausgewaehlteArbeiten}</h2>
      <p class="verweise">
        <a class="etikett alle" href={adresse('/projects/', sprache)}>{texte.alleProjekte(projekte.length)}</a>
      </p>
    </div>

    <div class="feld datenleiste">
      <dl class="zellen">
        {
          daten.map((angabe) => (
            <div>
              <dt class="etikett">{angabe.name}</dt>
              <dd>{angabe.wert}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <ol class="liste">
      {
        auswahl.map((projekt, stelle) => (
          <li>
            <ProjectEntry projekt={projekt} zuerst={stelle === 0} />
          </li>
        ))
      }
    </ol>
  </section>

  {
    weitereInhalte.length > 0 && (
      <section aria-labelledby="weitere">
        <div class="feld knapp geteilt abschnittskopf">
          <h2 class="etikett" id="weitere">{texte.weitereInhalte}</h2>
        </div>

        <ul class="liste">
          {weitereInhalte.map((eintrag) => (
            <li class="feld knapp geteilt zeile">
              <a class="ziel" href={eintrag.adresse}>
                <span class="zeile-titel">{eintrag.titel}</span>
                {eintrag.beschreibung !== '' && <span class="zeile-beschreibung">{eintrag.beschreibung}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .liste {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Datenleiste: Zellen wie ein Schriftfeld. Schmal zwei pro Zeile, die
     Themen darunter über die ganze Breite. */
  .datenleiste {
    padding: 0;
  }

  .datenleiste dl {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .datenleiste dl > div:nth-child(3) {
    grid-column: 1 / -1;
  }

  /* Abschnittskopf: der Name links, die Verweise rechts. Breit steht der
     Name in der linken Spalte des Rasters. */
  .abschnittskopf {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-8) var(--space-24);
  }

  .abschnittskopf h2 {
    color: var(--color-text);
  }

  /* Zwei Verweise nebeneinander: Flex mit Lücke, weil compressHTML den
     Leerraum zwischen Links entfernt. */
  .verweise {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-24);
  }

  .alle {
    text-decoration-color: var(--color-haarlinie);
  }

  .alle:hover {
    color: var(--color-text);
    text-decoration-color: currentColor;
  }

  /* Weitere Inhalte: jede Zeile ist ein Link über die ganze Breite, breit
     der Titel links und die Beschreibung rechts der Teilungslinie. */
  .zeile {
    padding-block: var(--space-24);
    transition: background-color 0.3s ease;
  }

  .zeile:hover {
    background-color: var(--color-flaeche);
  }

  .ziel {
    display: grid;
    gap: var(--space-4) var(--luecke);
    color: inherit;
    text-decoration: none;
  }

  .ziel::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .zeile-titel {
    font-size: var(--text-h2);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: var(--laufweite-titel);
  }

  .zeile:hover .zeile-titel {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .zeile-beschreibung {
    color: var(--color-text-muted);
  }

  @media (min-width: 40rem) {
    .datenleiste dl {
      grid-template-columns: 1fr 1fr 2fr;
    }

    .datenleiste dl > div:nth-child(3) {
      grid-column: auto;
    }
  }

  @media (min-width: 60rem) {
    .datenleiste dl {
      grid-template-columns: var(--erste-spalte) 1fr 3fr;
    }

    .abschnittskopf {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      column-gap: var(--luecke);
    }

    .abschnittskopf .verweise {
      justify-content: flex-end;
    }

    .ziel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      align-items: baseline;
    }
  }
</style>
